# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.env
.venv
env/
venv/
ENV/

# Temporary data / uploaded files
server/data/
server/uploads/
agent/downloads/
*.log

# OS generated files
.DS_Store
Thumbs.db

# 打包好的 App（内含访问令牌，不提交）
dist/

# Mac App 编译产物（含访问令牌）
mac/build/
mac/.build/
mac/Sources/Generated/

# Android 发布签名（GitHub Actions 从 Secrets 注入）
app/android/key.properties
app/android/*.jks
app/android/*.keystore
